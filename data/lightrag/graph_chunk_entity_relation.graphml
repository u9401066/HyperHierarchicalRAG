    <edge source="AR-RAG" target="DAiD">
      <data key="d7">1.0</data>
      <data key="d8">DAiD is a training-free plug-and-use decoding strategy that directly merges the distribution of model-predicted patches with the distribution of retrieved patches in AR-RAG.</data>
      <data key="d9">method,research framework</data>
      <data key="d10">chunk-7e465c313730e93412238c5e48c4949a</data>
