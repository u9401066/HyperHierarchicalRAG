    <node id="Retrieval-Augmented Generation (RAG)">
      <data key="d0">Retrieval-Augmented Generation (RAG)</data>
      <data key="d1">concept</data>
      <data key="d2">Retrieval-Augmented Generation is an approach used to automate the process of generating literature reviews with a large language model.&lt;SEP&gt;RAG enables Large Language Models to generate grounded responses by leveraging external knowledge databases without altering model parameters.&lt;SEP&gt;Retrieval-Augmented Generation is a method used to make up for problems with using separate models.</data>
      <data key="d3">chunk-4ce3e0842ccf55f97b27f1a977faaa67&lt;SEP&gt;chunk-8b61b46112793ea564faf7bd71cfe6bb&lt;SEP&gt;chunk-c6514729c0089a7326462210b15d6b62</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1767713001</data>
      <data key="d6" />
    </node>
    <node id="Large Language Model GPT-3.5-turbo">
      <data key="d0">Large Language Model GPT-3.5-turbo</data>
      <data key="d1">technology</data>
      <data key="d2">GPT-3.5-turbo is a type of large language model utilized in this research for automatic generation of literature reviews.</data>
      <data key="d3">chunk-4ce3e0842ccf55f97b27f1a977faaa67</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1767712964</data>
      <data key="d6" />
    </node>
